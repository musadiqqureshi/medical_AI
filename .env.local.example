# Copy this file to .env.local and fill in your keys.

# --- LLM provider (OpenAI-compatible) ---
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=your-provider-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_SITE_URL=http://localhost:3005
LLM_SITE_NAME=Medical AI Assistant

# --- Supabase (auth + credits) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx    # or the legacy anon JWT
SUPABASE_SERVICE_ROLE_KEY=                          # secret; for post-payment credit grants

# --- Payments (Pakistan) ---
NEXT_PUBLIC_PAY_JAZZCASH=03xx-xxxxxxx
NEXT_PUBLIC_PAY_EASYPAISA=03xx-xxxxxxx
NEXT_PUBLIC_PAY_BANK="Bank — Account title — IBAN"
SAFEPAY_SECRET_KEY=
NEXT_PUBLIC_SAFEPAY_ENV=sandbox
